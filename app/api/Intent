// ==========================================
// TYPES
// ==========================================

type IntentType =
  | "RFP_OR_TENDER"
  | "VENDOR_REQUEST"
  | "PROJECT_OPPORTUNITY";

type BuyerSignal = {
  id: string;
  title: string;
  organisation: string | null;
  source: string;
  sourceUrl: string;
  publishedAt: string | null;
  country: string;
  countryCode: string;
  intentType: IntentType;
  evidence: string;
  matchedTerms: string[];
  confidence: number;
  status: "NEW";
};

// ==========================================
// XML HELPERS
// ==========================================

function decodeXml(value: string): string {
  return value
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&#x27;/g, "'")
    .trim();
}

function extractTag(xml: string, tag: string): string {
  const match = xml.match(
    new RegExp(`<${tag}(?:\\s[^>]*)?>([\\s\\S]*?)</${tag}>`, "i")
  );

  return match ? decodeXml(match[1]) : "";
}

function cleanText(value: string): string {
  return value
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

// ==========================================
// INTENT CLASSIFICATION
// ==========================================

function identifyIntent(
  title: string,
  description: string
): {
  type: IntentType | null;
  confidence: number;
  matchedTerms: string[];
} {
  const text = `${title} ${description}`.toLowerCase();

  const patterns: {
    type: IntentType;
    confidence: number;
    terms: string[];
  }[] = [
    {
      type: "RFP_OR_TENDER",
      confidence: 95,
      terms: [
        "request for proposal",
        "request for quotation",
        "software development tender",
        "it services tender",
        "invitation to tender",
        "expression of interest",
        "request for bids",
        "procurement notice",
      ],
    },
    {
      type: "VENDOR_REQUEST",
      confidence: 85,
      terms: [
        "looking for a software developer",
        "looking for software development",
        "seeking a software developer",
        "seeking a technology vendor",
        "looking for a development company",
        "seeking a development partner",
        "looking for an app developer",
      ],
    },
    {
      type: "PROJECT_OPPORTUNITY",
      confidence: 65,
      terms: [
        "develop a new website",
        "develop a mobile application",
        "software development project",
        "digital transformation project",
        "new technology platform",
        "web application development",
      ],
    },
  ];

  for (const pattern of patterns) {
    const matchedTerms = pattern.terms.filter((term) =>
      text.includes(term)
    );

    if (matchedTerms.length > 0) {
      return {
        type: pattern.type,
        confidence: pattern.confidence,
        matchedTerms,
      };
    }
  }

  return {
    type: null,
    confidence: 0,
    matchedTerms: [],
  };
}

// ==========================================
// ORGANISATION EXTRACTION
// ==========================================

function getOrganisation(title: string): string | null {
  const patterns = [
    /(?:by|from|issued by|published by)\s+([A-Z][A-Za-z0-9&.,' -]{2,60})/,
    /^([A-Z][A-Za-z0-9&.,' -]{2,45})\s+(?:seeks|seeking|invites|announces)/,
  ];

  for (const pattern of patterns) {
    const match = title.match(pattern);

    if (match?.[1]) {
      return match[1].trim().replace(/[.,]+$/, "");
    }
  }

  return null;
}

// ==========================================
// GOOGLE NEWS RSS SEARCH
// ==========================================

async function searchMarket(
  market: (typeof MARKETS)[number],
  searchTerm: string
): Promise<BuyerSignal[]> {
  const query = encodeURIComponent(searchTerm);

  const url =
    `https://news.google.com/rss/search?q=${query}` +
    `&hl=en&gl=${market.code}&ceid=${market.locale}`;

  const controller = new AbortController();

  const timeout = setTimeout(() => controller.abort(), 10000);

  try {
    const response = await fetch(url, {
      headers: {
        "User-Agent": "HARVEY-InfoDart-Global/3.0",
      },
      signal: controller.signal,
      cache: "no-store",
    });

    if (!response.ok) {
      return [];
    }

    const xml = await response.text();

    const items =
      xml.match(/<item(?:\s[^>]*)?>[\s\S]*?<\/item>/gi) || [];

    const signals: BuyerSignal[] = [];

    for (const item of items) {
      const title = cleanText(extractTag(item, "title"));
      const link = extractTag(item, "link");
      const description = cleanText(
        extractTag(item, "description")
      );

      const pubDate = extractTag(item, "pubDate");
      const source = cleanText(extractTag(item, "source"));

      if (!title || !link) {
        continue;
      }

      const intent = identifyIntent(title, description);

      if (!intent.type) {
        continue;
      }

      signals.push({
        id: `${market.code}-${Buffer.from(link)
          .toString("base64url")
          .slice(0, 24)}`,

        title,

        organisation: getOrganisation(title),

        source: source || "Google News",

        sourceUrl: link,

        publishedAt: pubDate
          ? Number.isNaN(Date.parse(pubDate))
            ? null
            : new Date(pubDate).toISOString()
          : null,

        country: market.name,

        countryCode: market.code,

        intentType: intent.type,

        evidence: `${title}. ${description}`.slice(0, 700),

        matchedTerms: intent.matchedTerms,

        confidence: intent.confidence,

        status: "NEW",
      });
    }

    return signals;
  } catch {
    return [];
  } finally {
    clearTimeout(timeout);
  }
}

// ==========================================
// MAIN BUYER INTENT API
// ==========================================

export async function GET(request: NextRequest) {
  try {
    const params = request.nextUrl.searchParams;

    const requestedCountry = params.get("country");
    const requestedType = params.get("type");

    const minimumConfidence = Math.min(
      100,
      Math.max(
        0,
        Number(params.get("minConfidence") || 60)
      )
    );

    // COUNTRY VALIDATION

    const selectedMarkets = requestedCountry
      ? MARKETS.filter(
          (market) =>
            market.code === requestedCountry.toUpperCase()
        )
      : [...MARKETS];

    if (requestedCountry && selectedMarkets.length === 0) {
      return NextResponse.json(
        {
          success: false,
          error: "This country is not in HARVEY's approved market list.",
        },
        { status: 403 }
      );
    }

    // SEARCH PUBLIC BUYING SIGNALS

    const signals: BuyerSignal[] = [];

    const jobs = selectedMarkets.flatMap((market) =>
      SEARCH_TERMS.map((term) => ({
        market,
        term,
      }))
    );

    // Limit concurrent requests.

    for (let i = 0; i < jobs.length; i += 8) {
      const batch = jobs.slice(i, i + 8);

      const results = await Promise.all(
        batch.map(({ market, term }) =>
          searchMarket(market, term)
        )
      );

      signals.push(...results.flat());
    }

    // REMOVE DUPLICATES AND APPLY FILTERS

    const uniqueSignals = new Map<string, BuyerSignal>();

    for (const signal of signals) {
      if (signal.confidence < minimumConfidence) {
        continue;
      }

      if (
        requestedType &&
        signal.intentType !== requestedType.toUpperCase()
      ) {
        continue;
      }

      if (!uniqueSignals.has(signal.sourceUrl)) {
        uniqueSignals.set(signal.sourceUrl, signal);
      }
    }

    const finalSignals = Array.from(
      uniqueSignals.values()
    ).sort((a, b) => b.confidence - a.confidence);

    // RESPONSE

    return NextResponse.json({
      success: true,

      engine: "HARVEY BUYER INTENT HUNTER",

      version: "3.0.0",

      searchedMarkets: selectedMarkets.map(
        (market) => market.name
      ),

      searchedQueries: SEARCH_TERMS.length,

      totalSignals: finalSignals.length,

      filters: {
        country: requestedCountry || "ALL APPROVED MARKETS",
        intentType: requestedType || "ALL",
        minimumConfidence,
      },

      signals: finalSignals,

      limitations: [
        "Results are public news-indexed buying signals.",
        "Results are not independently verified buyers.",
        "A news article may describe an opportunity that has already closed.",
        "Organisation names and confidence scores are preliminary.",
        "Check the original source before contacting a prospect.",
      ],
    });
  } catch (error) {
    console.error("HARVEY INTENT ERROR:", error);

    return NextResponse.json(
      {
        success: false,
        engine: "HARVEY BUYER INTENT HUNTER",
        error:
          error instanceof Error
            ? error.message
            : "Buyer Intent search failed.",
        signals: [],
      },
      { status: 500 }
    );
  }
}
